# sgridmon — optional .env for docker compose. Placeholders only.
#
# You do not need this file: `docker compose up -d --build` works without it and
# everything below "Application settings" can be edited from the web UI
# (Settings, the gear button). Those settings live in the config file
# /app/config/sgridmon.env (the "config" volume) and override the environment.

# ── Deployment (read by docker compose) ───────────────────────────────────────
# Password of the bundled PostgreSQL (the `db` service). Set it before the first
# start; changing it later also requires changing it inside PostgreSQL.
POSTGRES_PASSWORD=change-me-too
# Published address and port.
SGRIDMON_BIND=127.0.0.1
SGRIDMON_PORT=8090
# First admin user, created only if the users table is empty. If unset,
# admin@example.com is created with a random password printed in the app log.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# 1 = serve a synthetic 3-site grid, no StorageGRID needed (login demo@example.com / demo)
SGRIDMON_DEMO=0

# ── Application settings (seed the config file on the first start only) ───────
# After the first start, change these in the UI (or edit the config file) instead.

# Base URL of an Admin Node (Grid Manager). Node FQDNs shown in the UI are built
# as <node-name>.<domain of this URL>.
SGRID_URL=https://admin01.grid.example.com
# A dedicated local grid user. Read-only access is enough; root is not needed.
SGRID_USER=sgridmon
SGRID_PASS=change-me
# Grid Management API version (sgridmon requires v4, StorageGRID 11.8 or later).
SGRID_API_VERSION=4
# Verify the Admin Node TLS certificate. Set to false for self-signed certificates.
SGRID_VERIFY_TLS=true
# Optional CA bundle (path inside the container) used when SGRID_VERIFY_TLS=true.
SGRID_CA_BUNDLE=
# Optional proxy for StorageGRID API calls only, e.g. http://proxy.example.com:3128
SGRID_PROXY=

# Polling (seconds)
POLL_INTERVAL=60
METRICS_INTERVAL=60
BUCKET_POLL_INTERVAL=7200
BUCKET_RETENTION_DAYS=90

# Physical/logical ratio shown in the tenants table (depends on your ILM policy).
EC_OVERHEAD=1.5

# Key used to sign session cookies. If empty, one is generated and stored in the
# config file on the first start.
SECRET_KEY=
# Set to true when sgridmon is served over HTTPS (behind a reverse proxy).
SESSION_COOKIE_SECURE=false

# ── Without docker compose ────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://sgridmon:change-me-too@localhost/sgridmon
# DATABASE_URL=sqlite+aiosqlite:///./sgridmon.db
# SGRIDMON_CONFIG=./config/sgridmon.env
