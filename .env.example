# sgridmon configuration — copy to .env and fill in. Placeholders only.

# ── StorageGRID ───────────────────────────────────────────────────────────────
# Base URL of an Admin Node (Grid Manager). Node FQDNs shown in the UI are built
# as <node-name>.<domain of this URL>.
SGRID_URL=https://admin01.grid.example.com
# A dedicated local grid user. Read-only access is enough; root is not needed.
SGRID_USER=sgridmon
SGRID_PASS=change-me
# Grid Management API version (sgridmon requires v4, StorageGRID 11.8 or later).
SGRID_API_VERSION=4
# Verify the Admin Node TLS certificate. Set to false for self-signed certificates.
SGRID_VERIFY_TLS=true
# Optional CA bundle (path inside the container) used when SGRID_VERIFY_TLS=true.
SGRID_CA_BUNDLE=
# Optional proxy for StorageGRID API calls only, e.g. http://proxy.example.com:3128
SGRID_PROXY=

# ── Polling (seconds) ─────────────────────────────────────────────────────────
POLL_INTERVAL=60
METRICS_INTERVAL=60
BUCKET_POLL_INTERVAL=7200
BUCKET_RETENTION_DAYS=90

# Physical/logical ratio shown in the tenants table (depends on your ILM policy).
EC_OVERHEAD=1.5

# ── Web / auth ────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies, e.g. `openssl rand -base64 48`.
# If empty, a random key is generated at start-up (sessions end on restart).
SECRET_KEY=
# Set to true when sgridmon is served over HTTPS (behind a reverse proxy).
SESSION_COOKIE_SECURE=false
# First admin user, created only if the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker compose for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me-too
# When running without docker compose:
# DATABASE_URL=postgresql+asyncpg://sgridmon:change-me-too@localhost/sgridmon
# DATABASE_URL=sqlite+aiosqlite:///./sgridmon.db

# ── Published port ────────────────────────────────────────────────────────────
SGRIDMON_BIND=127.0.0.1
SGRIDMON_PORT=8090

# ── Demo mode ─────────────────────────────────────────────────────────────────
# 1 = serve a synthetic 3-site grid, no StorageGRID needed (login demo@example.com / demo)
SGRIDMON_DEMO=0
